{
  "rewrites": [
    { "source": "/p/:slug", "destination": "/api/product?lang=en&slug=:slug" },
    { "source": "/ar/p/:slug", "destination": "/api/product?lang=ar&slug=:slug" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/beauty", "destination": "/beauty.html" },
    { "source": "/athlete", "destination": "/athlete.html" },
    { "source": "/ar", "destination": "/ar/index.html" },
    { "source": "/ar/beauty", "destination": "/ar/beauty.html" },
    { "source": "/ar/athlete", "destination": "/ar/athlete.html" },
      { "source": "/policies", "destination": "/policies.html" },
   { "source": "/track", "destination": "/track.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        { "key": "Content-Security-Policy-Report-Only", "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob: https://*.supabase.co; connect-src 'self' https://*.supabase.co; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" }
      ]
    },
    { "source": "/sw.js", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] },
    { "source": "/assets/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" } ] },
    { "source": "/vendor/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" } ] }
  ]
}
